# web/Dockerfile copies only the built bundle and the server config, so keep
# everything else — above all the multi-gigabyte cargo target directory — out
# of the context that is handed to the daemon.
*
!dist/
!dist/web/
!dist/web/**
!dist/server/
!dist/server/ryggattack-server
!web/
!web/nginx.conf
!web/nginx-main.conf
